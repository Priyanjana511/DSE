<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Department Webpage</title>

    <style>
        /* ID selector */
        #header {
            background-color: #2c3e50;
            color: white;
            text-align: center;
            padding: 15px;
        }

        /* Class selector */
        .navbar {
            background-color: #34495e;
            overflow: hidden;
        }

        .navbar ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .navbar li {
            float: left;
            position: relative;
        }

        /* Element selector */
        .navbar a {
            display: block;
            padding: 14px 20px;
            color: white;
            text-decoration: none;
        }

        /* Hover selector */
        .navbar li:hover {
            background-color: #1abc9c;
        }

        /* Dropdown menu */
        .dropdown {
            display: none;
            position: absolute;
            background-color: #2c3e50;
            min-width: 150px;
        }

        .dropdown a {
            display: block;
            padding: 10px;
        }

        /* Nested selector */
        .navbar li:hover .dropdown {
            display: block;
        }

        /* Content section */
        .content {
            padding: 20px;
            font-family: Arial;
        }

        /* Footer using ID */
        #footer {
            background-color: #2c3e50;
            color: white;
            text-align: center;
            padding: 10px;
            margin-top: 20px;
        }
    </style>

</head>

<body>

    <!-- Header -->
    <div id="header">
        <h1>Computer Science Department</h1>
        <p>Welcome to our department webpage</p>
    </div>

    <!-- Navigation Bar -->
    <div class="navbar">
        <ul>
            <li><a href="#">Home</a></li>

            <li>
                <a href="#">Faculty</a>
                <div class="dropdown">
                    <a href="#">Professors</a>
                    <a href="#">Assistant Professors</a>
                    <a href="#">Visiting Faculty</a>
                </div>
            </li>

            <li>
                <a href="#">Courses</a>
                <div class="dropdown">
                    <a href="#">BSc</a>
                    <a href="#">MSc</a>
                    <a href="#">PhD</a>
                </div>
            </li>

            <li>
                <a href="#">Activities</a>
                <div class="dropdown">
                    <a href="#">Workshops</a>
                    <a href="#">Seminars</a>
                    <a href="#">Hackathons</a>
                </div>
            </li>

            <li><a href="#">Contact</a></li>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="content">
        <h2>About Department</h2>
        <p>The Computer Science Department offers various undergraduate and postgraduate programs.</p>

        <h3>Highlights</h3>
        <ul>
            <li>Experienced Faculty</li>
            <li>Modern Labs</li>
            <li>Industry Exposure</li>
        </ul>
    </div>

    <!-- Footer -->
    <div id="footer">
        <p>&copy; 2026 Computer Science Department</p>
    </div>

</body>
</html>
