<!DOCTYPE html>
<html>
<head>
    <title>CSS Demo</title>

    <style>
        /* ---------- TEXT PROPERTIES ---------- */
        body {
            font-family: Arial, sans-serif;
            font-size: 16px;
            color: #333;
            background-color: #f4f4f4;
            line-height: 1.6;
        }

        h1, h2, h3 {
            color: #2c3e50;
            text-align: center;
        }

        p {
            text-align: justify;
            letter-spacing: 1px;
        }

        /* ---------- LIST PROPERTIES ---------- */
        ul {
            list-style-type: square;
            padding: 10px;
        }

        ol {
            list-style-type: upper-roman;
            padding: 10px;
        }

        li {
            margin: 5px 0;
            color: #555;
        }

        /* ---------- DIV PROPERTIES ---------- */
        div {
            margin: 20px;
            padding: 15px;
            border: 2px solid #ccc;
            background-color: #ffffff;
            border-radius: 8px;
        }

        .header {
            background-color: #2c3e50;
            color: white;
            text-align: center;
        }

        .footer {
            background-color: #2c3e50;
            color: white;
            text-align: center;
        }

        /* ---------- TABLE PROPERTIES ---------- */
        table {
            width: 80%;
            margin: auto;
            border-collapse: collapse;
            background-color: #fff;
        }

        th {
            background-color: #3498db;
            color: white;
            padding: 10px;
        }

        td {
            padding: 10px;
            text-align: center;
        }

        table, th, td {
            border: 1px solid black;
        }

        tr:hover {
            background-color: #f1f1f1;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
    </style>
</head>

<body>

    <div class="header">
        <h1>CSS Demo Page</h1>
    </div>

    <div>
        <h2>Text & List Example</h2>
        <p>This is a sample paragraph to show text styling.</p>

        <ul>
            <li>Item One</li>
            <li>Item Two</li>
        </ul>

        <ol>
            <li>First</li>
            <li>Second</li>
        </ol>
    </div>

    <div>
        <h2>Table Example</h2>
        <table>
            <tr>
                <th>Name</th>
                <th>Marks</th>
            </tr>
            <tr>
                <td>John</td>
                <td>85</td>
            </tr>
            <tr>
                <td>Emma</td>
                <td>90</td>
            </tr>
        </table>
    </div>

    <div class="footer">
        <p>Footer Section</p>
    </div>

</body>
</html>
