/* ---------- TEXT PROPERTIES ---------- */
body {
    font-family: Arial, sans-serif;
    font-size: 16px;
    color: #333;
    background-color: #f4f4f4;
    line-height: 1.6;
}

h1, h2, h3 {
    color: #2c3e50;
    text-align: center;
}

p {
    text-align: justify;
    letter-spacing: 1px;
}

/* ---------- LIST PROPERTIES ---------- */
ul {
    list-style-type: square;
    padding: 10px;
}

ol {
    list-style-type: upper-roman;
    padding: 10px;
}

li {
    margin: 5px 0;
    color: #555;
}

/* ---------- DIV PROPERTIES ---------- */
div {
    margin: 20px;
    padding: 15px;
    border: 2px solid #ccc;
    background-color: #ffffff;
    border-radius: 8px;
}

.header {
    background-color: #2c3e50;
    color: white;
    text-align: center;
}

.footer {
    background-color: #2c3e50;
    color: white;
    text-align: center;
}

/* ---------- TABLE PROPERTIES ---------- */
table {
    width: 80%;
    margin: auto;
    border-collapse: collapse;
    background-color: #fff;
}

th {
    background-color: #3498db;
    color: white;
    padding: 10px;
}

td {
    padding: 10px;
    text-align: center;
}

table, th, td {
    border: 1px solid black;
}

/* Hover effect on table rows */
tr:hover {
    background-color: #f1f1f1;
}

/* Alternate row colors */
tr:nth-child(even) {
    background-color: #f9f9f9;
}
