<!DOCTYPE html>
<html>
<head>
    <title>HTML Formatting Example</title>
</head>

<body style="background-color: lightyellow;">

    <!-- Heading -->
    <h1 style="color: blue; text-align: center;">Welcome to HTML Formatting Page</h1>

    <!-- Marquee -->
    <marquee behavior="scroll" direction="left" style="color: red;">
        This is a scrolling marquee text!
    </marquee>

    <hr>

    <!-- Paragraph with formatting -->
    <p>
        This is a <b>bold</b> text.<br>
        This is an <i>italic</i> text.<br>
        This is an <u>underlined</u> text.<br>
    </p>

    <!-- Colors and Fonts -->
    <p style="color: green; font-family: Arial; font-size: 18px;">
        This paragraph is styled with color and font.
    </p>

    <!-- Font Width (using size/spacing) -->
    <p style="letter-spacing: 3px;">
        This text has increased font width (letter spacing).
    </p>

    <hr>

    <!-- Multiple Headings -->
    <h2>Heading 2</h2>
    <h3>Heading 3</h3>
    <h4>Heading 4</h4>

    <!-- Another Paragraph -->
    <p>
        HTML allows us to format text easily.<br>
        Line break is used to move to next line.
    </p>

    <hr>

    <!-- Another marquee -->
    <marquee direction="right" style="color: purple;">
        Learning HTML is fun!
    </marquee>

</body>
</html>
